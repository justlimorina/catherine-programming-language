define a, b, c, d, x, x1, x2 as number
define is_running as boolean

is_running = true

while is_running == true {
    echo "--- Giai Phuong Trinh Bac 2 ---"
    echo "Nhap so a: "
    listen a

    echo "Nhap so b: "
    listen b

    echo "Nhap so c: "
    listen c

    d = calc(b * b - 4 * a * c)

    if d == 0 {
        x = calc((0 - b) / (2 * a))
        echo "Phuong trinh co nghiem kep: !{x}"
    } ef d > 0 {
        x1 = calc((0 - b + sqrt(d)) / (2 * a))
        x2 = calc((0 - b - sqrt(d)) / (2 * a))
        echo "Phuong trinh co 2 nghiem phan biet: x1 = !{x1} va x2 = !{x2}"
    } else {
        echo "Phuong trinh vo nghiem"
    }

    echo "Ban co muon tiep tuc khong? (nhap true/false): "
    listen is_running
}

echo "Da thoat chuong trinh. Tam biet!"